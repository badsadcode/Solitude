; Engine configuration file.
; Solitude — Bad Ideas Works

config_version=5

[application]

config/name="Solitude"
config/description="A lonely submarine captain on an alien ocean world."
config/version="0.8.4"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/bg_color=Color(0, 0.012, 0.02, 1)
boot_splash/image="res://assets/branding/boot_splash.png"
boot_splash/fullsize=true
boot_splash/stretch_mode=1
boot_splash/use_filter=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"

[dotnet]

project/assembly_name="Solitude"

[filesystem]

import/blender/enabled=false

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lights_and_shadows/positional_shadow/atlas_size=2048
